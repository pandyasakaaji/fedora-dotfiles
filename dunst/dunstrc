[global]
    font = JetBrainsMono Nerd Font 10

    origin = top-right
    offset = 20x20

    width = 240
    notification_limit = 5

    corner_radius = 17
    frame_width = 2

    padding = 14
    horizontal_padding = 16
    gap_size = 8

    background = "#24283B66"
    foreground = "#D8DEE9"
    frame_color = "#81A1C1"

    timeout = 5
    word_wrap = yes
    ellipsize = middle
    script = ~/.config/dunst/play_sound.sh

[urgency_low]
    background = "#24283B66"
    foreground = "#A3BE8C"
    frame_color = "#414868"

[urgency_normal]
    background = "#24283B66"
    foreground = "#D8DEE9"
    frame_color = "#81A1C1"

[urgency_critical]
    background = "#24283B66"
    foreground = "#ECEFF4"
    frame_color = "#BF616A"
