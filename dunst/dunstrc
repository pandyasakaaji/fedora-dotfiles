[global]
    font = JetBrainsMono Nerd Font 10

    origin = top-right
    offset = 20x20

    width = 240
    notification_limit = 5

    corner_radius = 17
    frame_width = 1

    padding = 14
    horizontal_padding = 16
    gap_size = 8

    background = "#24283bAA"
    foreground = "#a9b1d6"
    frame_color = "#3d59a1"

    timeout = 5
    word_wrap = yes
    ellipsize = middle
    script = ~/.config/dunst/play_sound.sh

[urgency_low]
    background = "#24283bAA"
    foreground = "#787c99"
    frame_color = "#414868"

[urgency_normal]
    background = "#24283bAA"
    foreground = "#a9b1d6"
    frame_color = "#7aa2f7"

[urgency_critical]
    background = "#24283bAA"
    foreground = "#f7768e"
    frame_color = "#f7768e"
